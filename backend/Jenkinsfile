pipeline {
    agent any

    tools {
        gradle 'Gradle 8.14.3'
    }

    environment {
        GRADLE_OPTS = '-Dorg.gradle.daemon=false'
        BUILD_WEBHOOK_URL = credentials('BUILD_WEBHOOK_URL')
        CODEBERG_TOKEN = credentials('CODEBERG_TOKEN')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                script {
                    dir("backend") {
                        sh './gradlew clean build -x test'
                    }
                }
            }
        }

        stage('Test') {
            steps {
                script {
                    dir("backend") {
                        sh './gradlew test'
                    }
                }
            }
            post {
                always {
                    // Publish test results
                    junit 'backend/**/build/test-results/test/*.xml'

                    // Publish Jacoco coverage report
                    recordCoverage tools: [[parser: 'JACOCO', pattern: 'backend/**/build/reports/jacoco/test/jacocoTestReport.xml']],
                                   sourceCodeRetention: 'LAST_BUILD'
                }
            }
        }

        stage('Archive') {
            steps {
                // Archive the built artifacts
                archiveArtifacts artifacts: 'backend/**/build/libs/*.jar', fingerprint: true
            }
        }

        stage('Find PR number') {
            steps {
                script {
                    def currentBranchHash = env.GIT_COMMIT

                    def repoUrl = env.GIT_URL
                    def parts = repoUrl.split('/')
                    def owner = parts[-2]
                    def repo = parts[-1]

                    def prList = sh(
                        script: """
                            curl -s -H "Authorization: token ${env.CODEBERG_TOKEN}" "https://codeberg.org/api/v1/repos/${owner}/${repo}/pulls?state=open"
                        """,
                        returnStdout: true
                    )

                    def prs = readJSON(text: prList)
                    def prNo = null

                    for (pr in prs) {
                        if (pr.head?.sha == currentBranchHash) {
                            prNo = pr.number
                        }
                    }

                    env.PR_NUMBER = prNo
                    echo "Found PR number: ${prNo}"
                }
            }
        }
    }

    post {
        success {
            echo 'Build succeeded'
        }
        failure {
            echo 'Build failed'
        }
        always {
            script {
                try {
                    // Send pipeline and test results to n8n webhook (for notifications)
                    def testSummary = junit 'backend/**/build/test-results/test/*.xml'
                    echo "Total: ${testSummary.totalCount}, Passed: ${testSummary.passCount}, Failed: ${testSummary.failCount}, Skipped: ${testSummary.skipCount}"

                    httpRequest(
                        httpMode: 'POST',
                        url: env.BUILD_WEBHOOK_URL,
                        contentType: 'APPLICATION_JSON',
                        requestBody: """
                        {
                          "job": "${env.JOB_NAME}",
                          "build": "${env.BUILD_NUMBER}",
                          "url": "${env.BUILD_URL}",
                          "status": "${currentBuild.currentResult}",
                          "tests": {
                            "total": ${testSummary.totalCount},
                            "passed": ${testSummary.passCount},
                            "failed": ${testSummary.failCount},
                            "skipped": ${testSummary.skipCount}
                          }
                        }
                        """
                    )
                } catch (Exception e) {
                    echo "Failed to send webhook: ${e.message}"
                    e.printStackTrace()
                }
            }

            // Clean up workspace
            cleanWs()
        }
    }
}