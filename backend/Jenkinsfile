def FAILED_STAGE

pipeline {
    agent any

    tools {
        gradle 'Gradle 8.14.3'
    }

    environment {
        GRADLE_OPTS = '-Dorg.gradle.daemon=false'
        BUILD_WEBHOOK_URL = credentials('BUILD_WEBHOOK_URL')
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    FAILED_STAGE=env.STAGE_NAME
                }
                checkout scm
            }
        }

        stage('Get commit info') {
            steps {
                script {
                    FAILED_STAGE=env.STAGE_NAME
                    env.COMMIT_MSG = sh(script: 'git log -1 --pretty=%B', returnStdout: true).trim()
                    env.COMMIT_SUBJECT = sh(script: 'git log -1 --pretty=%s', returnStdout: true).trim()
                }
            }
        }

        stage('Build') {
            steps {
                script {
                    FAILED_STAGE=env.STAGE_NAME
                    dir("backend") {
                        sh './gradlew clean build -x test'
                    }
                }
            }
        }

        stage('Test') {
            steps {
                script {
                    FAILED_STAGE=env.STAGE_NAME
                    dir("backend") {
                        sh './gradlew test'
                    }
                }
            }
            post {
                always {
                    // Publish Jacoco coverage report
                    // (test results are published once, in the pipeline-level post block)
                    recordCoverage tools: [[parser: 'JACOCO', pattern: 'backend/**/build/reports/jacoco/test/jacocoTestReport.xml']],
                                   sourceCodeRetention: 'LAST_BUILD'
                }
            }
        }

        stage('Archive') {
            steps {
                script {
                    FAILED_STAGE=env.STAGE_NAME
                }
                // Archive the built artifacts
                archiveArtifacts artifacts: 'backend/**/build/libs/*.jar', fingerprint: true
            }
        }

        stage('Count LOC') {
            steps {
                def loc = sh(
                    script: "cloc --json --quiet --exclude-dir=build,gradle --include-lang=Kotlin backend/ | jq '.SUM.code'",
                    returnStdout: true
                ).trim()

                def badge = addEmbeddableBadgeConfiguration(id: 'loc', subject: 'Lines of code')
                badge.setStatus(loc)
                badge.setColor('blue')
            }
        }
    }

    post {
        success {
            echo 'Build succeeded'
        }
        failure {
            echo 'Build failed'
        }
        always {
            script {
                try {
                    def testSummary = junit(testResults: 'backend/**/build/test-results/test/*.xml', allowEmptyResults: true)
                    env.TEST_RUN = testSummary.totalCount > 0 ? 'true' : 'false'
                    env.TEST_TOTAL_COUNT = testSummary.totalCount
                    env.TEST_PASS_COUNT = testSummary.passCount
                    env.TEST_FAIL_COUNT = testSummary.failCount
                    env.TEST_SKIP_COUNT = testSummary.skipCount
                } catch (Exception e) {
                    echo "Failed to publish test results: ${e.message}"
                    env.TEST_RUN = 'false'
                    env.TEST_TOTAL_COUNT = '0'
                    env.TEST_PASS_COUNT = '0'
                    env.TEST_FAIL_COUNT = '0'
                    env.TEST_SKIP_COUNT = '0'
                }
            }

            withCredentials([string(credentialsId: 'CODEBERG_TOKEN', variable: 'CODEBERG_TOKEN')]) {
                script {
                    try {
                        def currentBranchHash = env.GIT_COMMIT

                        def repoUrl = env.GIT_URL
                        def parts = repoUrl.split('/')
                        def owner = parts[-2]
                        def repo = parts[-1]

                        def prList = sh(
                            script: """
                                curl -s -H "Authorization: token ${CODEBERG_TOKEN}" "https://codeberg.org/api/v1/repos/${owner}/${repo}/pulls?state=open"
                            """,
                            returnStdout: true
                        )

                        def prs = readJSON(text: prList)
                        def prNo = null

                        for (pr in prs) {
                            if (pr.head?.sha == currentBranchHash) {
                                prNo = pr.number
                            }
                        }

                        env.PR_NUMBER = prNo
                        echo "Found PR number: ${prNo}"

                        if (prNo != null) {

                            def header = currentBuild.result == 'SUCCESS'
                                ? "# ✔ Build succeeded!\n\n"
                                : "# ⚠ Build failed!\n\n"

                            def testBody = env.TEST_RUN == 'true' ? """\
                            **Test summary** for commit `${currentBranchHash}` on branch `${GIT_BRANCH}`:

                            - **Total Tests**: ${env.TEST_TOTAL_COUNT}
                            - **Passed Tests**: ${env.TEST_PASS_COUNT}
                            - **Failed Tests**: ${env.TEST_FAIL_COUNT}
                            - **Skipped Tests**: ${env.TEST_SKIP_COUNT}

                            [See all test results](${env.BUILD_URL}testReport/)
                            """.stripIndent()
                            : """\
                            > [!WARNING]
                            > No tests were run. The pipeline failed at stage **${FAILED_STAGE}**.
                            """.stripIndent()

                            def body = """\
                            ```text
                            {{msg}}
                            ```

                            {{tests}}

                            ---
                            """.stripIndent()
                                .replace("{{msg}}", env.COMMIT_MSG)
                                .replace("{{tests}}", testBody)

                            def footer = "\n\n> This action was performed automatically by a Jenkins pipeline (not AI :D)."

                            def fullBody = header + body + footer
                            def jsonBody = groovy.json.JsonOutput.toJson([body: fullBody])

                            writeFile(file: 'comment.json', text: jsonBody)

                            def response = sh(
                                script: """
                                    curl -X POST \
                                        -H "Authorization: token ${CODEBERG_TOKEN}" \
                                        -H "Content-Type: application/json" \
                                        -d @comment.json \
                                        "https://codeberg.org/api/v1/repos/${owner}/${repo}/issues/${prNo}/comments"
                                """,
                                returnStdout: true
                            )

                            echo "API response: ${response}"
                        }
                    } catch (Exception e) {
                        echo "Failed to send PR comment: ${e.message}"
                        e.printStackTrace()
                    }

                }
            }

            script {
                try {
                    // Send pipeline and test results to n8n webhook (for notifications)
                    echo "Total: ${env.TEST_TOTAL_COUNT}, Passed: ${env.TEST_PASS_COUNT}, Failed: ${env.TEST_FAIL_COUNT}, Skipped: ${env.TEST_SKIP_COUNT}"

                    httpRequest(
                        httpMode: 'POST',
                        url: env.BUILD_WEBHOOK_URL,
                        contentType: 'APPLICATION_JSON',
                        requestBody: """
                        {
                          "job": "${env.JOB_NAME}",
                          "build": "${env.BUILD_NUMBER}",
                          "url": "${env.BUILD_URL}",
                          "status": "${currentBuild.currentResult}",
                          "tests": {
                            "total": ${env.TEST_TOTAL_COUNT},
                            "passed": ${env.TEST_PASS_COUNT},
                            "failed": ${env.TEST_FAIL_COUNT},
                            "skipped": ${env.TEST_SKIP_COUNT}
                          }
                        }
                        """
                    )
                } catch (Exception e) {
                    echo "Failed to send webhook: ${e.message}"
                    e.printStackTrace()
                }
            }

            // Clean up workspace
            cleanWs()
        }
    }
}