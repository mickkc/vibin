# Database
# https://vibin.rip/docs/config#database-configuration
DB_HOST=vibin_db
DB_PORT=5432
DB_USER=vibin_user
DB_PASSWORD=your_password_here
DB_NAME=vibin_db

# Directories
# https://vibin.rip/docs/config#directory-configuration
# if you are using docker, these are the directories inside the container. Update your volume mappings accordingly.
#MUSIC_DIR=/opt/vibin/music
#UPLOADS_DIR=/opt/vibin/uploads
#THUMBNAIL_DIR=/opt/vibin/thumbnails
#IMAGE_CACHE_DIR=/opt/vibin/image_cache
#WIDGET_IMAGE_CACHE_DIR=/opt/vibin/widget_image_cache

# Rate limiting
# https://vibin.rip/docs/config#cache--rate-limiting-configuration
#WIDGET_CACHE_EXPIRATION_MINUTES=20
#WIDGET_IMAGE_CACHE_RATE_LIMIT_REQUESTS=5
#LOGIN_RATE_LIMIT_ATTEMPTS=5
#LOGIN_RATE_LIMIT_TIMEOUT=10

# Selenium
# https://vibin.rip/docs/config#selenium-configuration
#CHROME_BINARY_PATH=/usr/bin/chromium
#WIDGET_IMAGE_RENDER_POOL_SIZE=2
#SCRAPING_POOL_SIZE=2

# SMTP
# https://vibin.rip/docs/config#smtp-email-configuration
#SMTP_HOST=mail.example.org
#SMTP_PORT=465
#SMTP_STARTTLS=false
#SMTP_STARTTLS_REQUIRED=true
#SMTP_SSL=true
#SMTP_AUTH=true
#SMTP_USERNAME=example
#SMTP_PASSWORD=abc123
#SMTP_FROM=noreply@example.org
#SMTP_DELAY_MS=200
#SMTP_RETRIES=5
#SMTP_RETRY_DELAY_MS=2500
#SMTP_FAILED_MAILS_DIR=/opt/vibin/mails

# Server
# https://vibin.rip/docs/config#server-configuration
#SERVER_PORT=8080
#SERVER_HOST=0.0.0.0
#REAL_IP_HEADER=X-Forwarded-For
#EXTERNAL_URL=https://vibin.example.org
#SERVER_LANGUAGE=en
#LOG_LEVEL=info
#DEFAULT_ADMIN_PASSWORD=
